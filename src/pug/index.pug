mixin skill(name, level, label)
    .skill-item(data-level=level)
        .skill-header
            span.skill-name= name
        .skill-visual
            .skill-scale(role='img', aria-label=`${name} proficiency: ${label}`)
                span.skill-track
                span.skill-point(data-stage='beginner')
                span.skill-point(data-stage='lower-intermediate')
                span.skill-point(data-stage='intermediate')
                span.skill-point(data-stage='upper-intermediate')
                span.skill-point(data-stage='advanced')
            .skill-labels(aria-hidden='true')
                span(data-stage='beginner') Beginner
                span(data-stage='lower-intermediate') Lower-Intermediate
                span(data-stage='intermediate') Intermediate
                span(data-stage='upper-intermediate') Upper-Intermediate
                span(data-stage='advanced') Advanced

